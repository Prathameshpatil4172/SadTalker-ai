# ============================================
# SadTalker AI - Local GPU Server Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from your Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# ngrok Configuration (Required)
# ============================================
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ngrok region (default: in for India)
# Options: us, eu, au, ap, sa, jp, in
NGROK_REGION=in

# ============================================
# API Configuration
# ============================================
# Change this to a secure random string
API_SECRET=your-secret-key-here-change-this

# Flask server port (default: 5000)
FLASK_PORT=5000

# Flask debug mode (set to true for development)
FLASK_DEBUG=false

# ============================================
# Frontend Configuration (Required for CORS)
# ============================================
# Your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# Local Paths (Usually don't need to change)
# ============================================
CHECKPOINT_PATH=checkpoints
CONFIG_PATH=src/config
RESULT_DIR=static/results
UPLOAD_DIR=uploads
