# ============================================
# Frontend Environment Variables (Vercel)
# ============================================
# Copy this file to .env.local and fill in your values
# These variables are used by your Vercel frontend

# ============================================
# API Configuration (Required)
# ============================================
# Your ngrok public URL when running local GPU server
# Example: https://abc123.ngrok.io
NEXT_PUBLIC_API_URL=https://your-ngrok-url.ngrok.io/api/v1

# API Secret (optional, for protected endpoints)
NEXT_PUBLIC_API_SECRET=your-secret-key-here

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from your Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Optional Configuration
# ============================================
# App name (for display purposes)
NEXT_PUBLIC_APP_NAME=SadTalker AI

# Maximum file upload size in MB
NEXT_PUBLIC_MAX_FILE_SIZE=50
